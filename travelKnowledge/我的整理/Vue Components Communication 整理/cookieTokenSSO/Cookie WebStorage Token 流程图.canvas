		{"id":"f400000000000004","fromNode":"2400000000000004","fromSide":"right","toNode":"2400000000000005","toSide":"left","toEnd":"arrow","label":"提交 Refresh Token"},
		{"id":"f400000000000005","fromNode":"2400000000000005","fromSide":"right","toNode":"2400000000000006","toSide":"left","toEnd":"arrow","label":"验证 refresh 状态"},
		{"id":"f400000000000006","fromNode":"2400000000000006","fromSide":"right","toNode":"2400000000000007","toSide":"left","toEnd":"arrow","label":"返回状态"},
		{"id":"f400000000000007","fromNode":"2400000000000003","fromSide":"right","toNode":"2400000000000008","toSide":"left","toEnd":"arrow","label":"401 后刷新"},
		{"id":"f400000000000008","fromNode":"2400000000000003","fromSide":"right","toNode":"2400000000000009","toSide":"left","toEnd":"arrow","label":"快过期先刷新"},
