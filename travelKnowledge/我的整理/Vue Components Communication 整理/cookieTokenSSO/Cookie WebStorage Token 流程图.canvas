		{"id":"f300000000000001","fromNode":"2300000000000001","fromSide":"right","toNode":"2300000000000002","toSide":"left","toEnd":"arrow","label":"登录"},
		{"id":"f300000000000002","fromNode":"2300000000000002","fromSide":"right","toNode":"2300000000000003","toSide":"left","toEnd":"arrow","label":"签发 JWT"},
		{"id":"f300000000000003","fromNode":"2300000000000003","fromSide":"right","toNode":"2300000000000004","toSide":"left","toEnd":"arrow","label":"写入"},
		{"id":"f300000000000004","fromNode":"2300000000000004","fromSide":"right","toNode":"2300000000000005","toSide":"left","toEnd":"arrow","label":"读取 token"},
		{"id":"f300000000000005","fromNode":"2300000000000005","fromSide":"right","toNode":"2300000000000006","toSide":"left","toEnd":"arrow","label":"Authorization 手动携带"},
		{"id":"f400000000000001","fromNode":"2400000000000001","fromSide":"right","toNode":"2400000000000002","toSide":"left","toEnd":"arrow","label":"访问资源"},
		{"id":"f400000000000002","fromNode":"2400000000000002","fromSide":"right","toNode":"2400000000000003","toSide":"left","toEnd":"arrow","label":"验签 / 检查过期"},
