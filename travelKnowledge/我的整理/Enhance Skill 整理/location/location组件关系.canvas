		{"id":"3000000000000152","fromNode":"2000000000000162","fromSide":"right","toNode":"2000000000000163","toSide":"left","label":"runtime"},
		{"id":"3000000000000103","fromNode":"2000000000000113","fromSide":"left","toNode":"2000000000000111","toSide":"right","label":"child component"}
	]
}